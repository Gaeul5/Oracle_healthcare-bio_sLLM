**/data/raw/
*.zip
**/data/*.xlsx

# 원문이 포함된 파생 파일도 커밋 금지 (unified.jsonl, cadec_v1_sct.jsonl 등 전부)
**/data/*.jsonl
# fold_assignment.csv는 doc_id만 담아 원문이 없으므로 커밋한다
**/data/*.parquet

# 통계·집계만 커밋한다 (reports/)
__pycache__/
*.pyc
.ipynb_checkpoints/

# 부트캠프 실습 환경
.venv/
.env
.DS_Store
